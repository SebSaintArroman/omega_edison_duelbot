<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Offline bot-vs-bot duel simulator.

    Runs the real EDOPro rules engine (ocgcore.dll, 64-bit) and plays the bots against each other in-process.
    The bots talk to an in-memory emulation of Omega's bot API, so their code is used unchanged.

    The bot sources are compiled straight into this assembly (see the Compile items below) instead of referencing
    BotTest.csproj: building the simulator never touches BotTest's or OmegaBotWrapper's own bin/obj folders, so it
    can't clash with a running BotTest. Every simulator build picks up the current bot code.

    64-bit since 2026-11-19 (about 30% more search lines per second than 32-bit): a self-contained win-x64 app using
    vendor/ocgcore-x64/ocgcore.dll, built from vendor/ygopro-core (commit 9cd0936, the same version as the old 32-bit DLL;
    identical results on a fixed-line bench).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DuelSim</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Server GC: the play search runs lines on several threads and allocates a lot (about 15% faster). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- Warnings from the bot sources are the bot projects' business; keep the simulator build output readable. -->
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8619;CS8620;CS8625;CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS1998;CS4014;CS8321;CS8524;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2-beta1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Compile Include="..\OmegaBotWrapper\**\*.cs"
             Exclude="..\OmegaBotWrapper\bin\**;..\OmegaBotWrapper\obj\**;..\OmegaBotWrapper\Properties\AssemblyInfo.cs"
             Link="BotSources\OmegaBotWrapper\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\BotTest\**\*.cs"
             Exclude="..\BotTest\bin\**;..\BotTest\obj\**;..\BotTest\Program.cs"
             Link="BotSources\BotTest\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- The bot's embedded data (Edison deck lists for reading the opponent's deck). -->
    <EmbeddedResource Include="..\BotTest\Game\AI\Brains\Data\edison-decks.json" LogicalName="BotTest.Data.edison-decks.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="vendor\ocgcore-x64\ocgcore.dll" CopyToOutputDirectory="PreserveNewest" Link="ocgcore.dll" Condition="Exists('vendor\ocgcore-x64\ocgcore.dll')" />
  </ItemGroup>

</Project>
